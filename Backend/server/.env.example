PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=defaultdb
DB_SSL=true
DB_TLS_MIN_VERSION=TLSv1.2
DB_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=replace-with-a-long-random-secret
PYTHON_COMMAND=py

# ─── Docker Execution ────────────────────────────────────────────────────────
# Set USE_DOCKER=true to route all code execution through isolated Docker containers.
# Set USE_DOCKER=false (or remove) to fall back to local compiler binaries.
USE_DOCKER=true
DOCKER_C_CONTAINER=c-compiler
DOCKER_JAVA_CONTAINER=java-compiler
DOCKER_PYTHON_CONTAINER=python-compiler
# Scratch root INSIDE each compiler container for judged jobs. Must live on the
# container's writable overlay layer — NEVER a tmpfs mount — because `docker cp`
# cannot write into container-internal tmpfs mounts.
CONTAINER_JOB_ROOT=/workspace/jobs
# COMPOSE_FILE= -- optional override for the docker-compose file used to auto-start compilers

# ─── Execution Limits ────────────────────────────────────────────────────────
CODE_EXEC_TIMEOUT_MS=10000
CODE_EXEC_MAX_OUTPUT=1048576
